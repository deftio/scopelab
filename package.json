{
  "name": "scopelab",
  "version": "1.0.0",
  "description": "ScopeLab: live USB endoscope viewer with classical image filters, histograms and captures (bitwrench UI)",
  "private": true,
  "main": "server.js",
  "config": {
    "port": 8642
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/filters.test.js",
    "build:pages": "node scripts/build-pages.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BSD-2-Clause",
  "author": "manu a. chatterjee <deftio@deftio.com> (https://deftio.com/)",
  "dependencies": {
    "bitwrench": "^2.1.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftio/scopelab.git"
  },
  "homepage": "https://deftio.github.io/scopelab/",
  "bugs": {
    "url": "https://github.com/deftio/scopelab/issues"
  },
  "keywords": [
    "endoscope",
    "borescope",
    "uvc",
    "webcam",
    "webusb",
    "image-processing",
    "canny",
    "sobel",
